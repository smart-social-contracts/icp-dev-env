{
  "canisters": {
    "backend": {
      "type": "custom",
      "build": "CANISTER_CANDID_PATH=./backend.did python -m basilisk backend backend/src/main.py",
      "candid": "backend.did",
      "wasm": ".basilisk/backend/backend.wasm"
    },
    "frontend": {
      "dependencies": [
        "backend"
      ],
      "frontend": {
        "entrypoint": "frontend/src/index.html"
      },
      "source": [
        "frontend/src"
      ],
      "type": "assets"
    }
  }
}